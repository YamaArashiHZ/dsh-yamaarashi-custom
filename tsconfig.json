{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src"]
}
