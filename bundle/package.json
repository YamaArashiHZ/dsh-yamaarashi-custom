{
  "name": "@yamaarashihz/dsh-yamaarashi-custom",
  "version": "0.9.2",
  "private": true,
  "description": "Personal DeepSeek Harness customization suite: one bundle, one row per component package",
  "license": "MIT",
  "author": "YamaArashiHZ",
  "homepage": "https://github.com/YamaArashiHZ/dsh-yamaarashi-custom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamaArashiHZ/dsh-yamaarashi-custom.git",
    "directory": "bundle"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bundle",
    "customization"
  ],
  "icon": "assets/mascot-512.webp",
