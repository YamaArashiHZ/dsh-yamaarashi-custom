{
  "name": "@yamaarashihz/dsh-yamaarashi-deepseek-balance",
  "version": "0.2.1",
  "private": true,
  "description": "DeepSeek usage card: a sidebar card showing a custom DeepSeek account's balance and today's hourly spend",
  "license": "MIT",
  "author": "YamaArashiHZ",
  "homepage": "https://github.com/YamaArashiHZ/dsh-yamaarashi-custom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamaArashiHZ/dsh-yamaarashi-custom.git",
    "directory": "packages/deepseek-balance"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "usage",
    "balance"
  ],
  "icon": "assets/deepseek-balance.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/shared.js",
    "lib/host/*.js",
    "lib/client*.js",
    "lib/client*.js.map",
    "lib/types/**/*.d.ts",
    "assets/deepseek-balance.svg",
    "locale/*.json"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "prepack": "npm run build",
    "pack": "npm pack",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5"
  }
}
